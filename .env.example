# Copier en .env et compléter. Ne jamais versionner le fichier .env.

# Base PostgreSQL (hébergée dans l'UE)
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/revisions"
# Adresse publique du site (sert aux liens de retour Stripe)
APP_URL="https://revisions.exemple.fr"
# Dossier privé des documents importés (hors du dossier public, à sauvegarder)
STORAGE_DIR="./storage"

# Premier super-administrateur, créé par `npm run db:seed` (12 caractères minimum)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Stripe : laisser vide tant que le compte marchand n'est pas ouvert (le site l'indique clairement).
# sk_test_... pour la préproduction, sk_live_... pour la production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# IA (Anthropic, Claude) : laisser vide pour désactiver la génération assistée.
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"
